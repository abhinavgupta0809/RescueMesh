    "gemini:check": "tsx src/scripts/check-gemini.ts"
  },
  "dependencies": {
    "@rescuemesh/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "@rescuemesh/engine": "*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.5"
  }
}
