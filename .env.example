# Copy to .env. The demo runs fully without credentials; paste a key to enable
# live chief reasoning. Model requests are made only by the backend.
PORT=4000
VITE_API_URL=http://localhost:4000

# ── Gemini — powers the five in-app AI chiefs ─────────────────────────────────
# Get a key from Google AI Studio, then: GEMINI_API_KEY=AIza...
# Leave it blank to run the chiefs on deterministic mocks (clearly labelled).
GEMINI_API_KEY=

# Defaults below are fine; override only if you need to.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2

# ── IFM / K2 — development tooling only ───────────────────────────────────────
# Used by `npm run k2` and `npm run ifm:check`. NOT used for the chiefs.
IFM_API_KEY=
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
IFM_TIMEOUT_MS=60000
IFM_MAX_TOKENS=8000
IFM_TEMPERATURE=0.2

# Optional integrations (leave blank to use deterministic mocks)
MONGODB_URI=
GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
VULTR_API_KEY=
