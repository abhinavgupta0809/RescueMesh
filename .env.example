# Copy to .env. The demo runs without any credentials; paste a key to enable live reasoning.
PORT=4000
VITE_API_URL=http://localhost:4000

# ── IFM Labs (K2) — the only value you need to paste ──────────────────────────
# Get a key from the IFM Platform, then: IFM_API_KEY=IFM-xf...
# Leave it blank to run entirely on deterministic mock data.
IFM_API_KEY=

# Defaults below match the IFM hosted-model quickstart. Override only if IFM says to.
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
IFM_TIMEOUT_MS=60000
IFM_MAX_TOKENS=8000
IFM_TEMPERATURE=0.2

# Optional integration credentials (leave blank to use deterministic mocks)
MONGODB_URI=
GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
VULTR_API_KEY=
