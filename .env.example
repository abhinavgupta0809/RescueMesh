# Copy to .env. The demo runs fully without credentials; paste a key to enable
# live chief reasoning. Model requests are made only by the backend.
PORT=4000
VITE_API_URL=http://localhost:4000

# ── Gemini — powers the five in-app AI chiefs ─────────────────────────────────
# Get a key from Google AI Studio, then: GEMINI_API_KEY=AIza...
# Leave it blank to run the chiefs on deterministic mocks (clearly labelled).
GEMINI_API_KEY=

# Defaults below are fine; override only if you need to.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2

# ── IFM / K2 ─────────────────────────────────────────────────────────────────
# NOT used by RescueMesh at runtime. No IFM credential is required to run the
# demo, and no K2 request is ever made. These remain only for the standalone
# `npm run k2` / `npm run ifm:check` development tools, which are reserved for a
# separate Vault Ledger submission. Leave blank unless you are using those tools.
IFM_API_KEY=

# Optional integrations (leave blank to use deterministic mocks)
MONGODB_URI=
GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
VULTR_API_KEY=
